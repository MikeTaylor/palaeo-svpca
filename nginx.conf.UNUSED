# Serves the archive with the old svpca.org URLs working. A page that lived
# at /X.php?Q is stored as /X@Q.html, or as /X.html when the query made no
# difference. Adjust server_name and root, then include this in nginx's http block.
server {
    listen 80;
    server_name svpca.org;
    root /srv/svpca/site;
    index index.html;
    absolute_redirect off;

    location ~ ^(?<page>.+)\.php$ {
        try_files $page@$args.html $page.html =404;
    }

    location = /.htaccess {
        return 404;
    }
}
